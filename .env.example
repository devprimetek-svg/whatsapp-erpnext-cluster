# ==============================================================================
# WhatsApp Routing + ERPNext CRM Cluster Environment Variables
# Copy this file to .env and replace all placeholder values before starting.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Timezone
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Domains & Reverse Proxy (Caddy SSL)
# Ensure DNS A records for these 3 subdomains point to your GCP VM's Static External IP.
# ------------------------------------------------------------------------------
WA_GATEWAY_DOMAIN=wa-gateway.yourdomain.com
WA_MANAGER_DOMAIN=wa-manager.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com

# Email used by Let's Encrypt for TLS certificate registration and expiry alerts
ACME_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Required by Evolution API v2)
# ------------------------------------------------------------------------------
POSTGRES_DB=evolution_db
POSTGRES_USER=evolution_user
# Generate a strong password (e.g. openssl rand -hex 16)
POSTGRES_PASSWORD=replace_with_secure_postgres_password_min_16_chars

# ------------------------------------------------------------------------------
# 4. Redis Cache (Required by Evolution API v2)
# ------------------------------------------------------------------------------
# Generate a strong password (e.g. openssl rand -hex 16)
REDIS_PASSWORD=replace_with_secure_redis_password_min_16_chars

# ------------------------------------------------------------------------------
# 5. Evolution API v2 Authentication & Configuration
# ------------------------------------------------------------------------------
# Master global API key used to authenticate all requests to Evolution API and Manager UI.
# Generate a secure key (e.g. openssl rand -hex 24)
AUTHENTICATION_API_KEY=replace_with_secure_evolution_api_key_min_32_chars

# ------------------------------------------------------------------------------
# 6. n8n Automation Orchestrator
# ------------------------------------------------------------------------------
# Encryption key used by n8n to encrypt stored credentials in its database.
# Must be generated once and kept safe (e.g. openssl rand -hex 16).
N8N_ENCRYPTION_KEY=replace_with_secure_n8n_encryption_key_32_chars

# ------------------------------------------------------------------------------
# 7. Single Operational WhatsApp Number / Session Configuration
# Mandatory Rule: If an operational number gets banned, update ONLY this variable.
# The entire workflow routing dynamically switches to the new instance/session.
# ------------------------------------------------------------------------------
GLOBAL_OPERATIONAL_WA_NO=support_primary

# ------------------------------------------------------------------------------
# 8. Universal Web App Gateway & Translation Settings
# Allows external web applications (Node.js, React, Python, etc.) to use this cluster.
# ------------------------------------------------------------------------------
# Secret API key required by external web apps in the 'x-api-key' header
UNIVERSAL_GATEWAY_API_KEY=gateway_sec_replace_with_strong_random_token_32_chars

# Optional: URL of your external web app to receive inbound customer WhatsApp messages
WEBAPP_WEBHOOK_URL=https://your-webapp.yourdomain.com/api/webhooks/whatsapp

# Google Cloud Translation API Key (for automatic Tamil <-> English translation)
GCP_TRANSLATION_API_KEY=AIzaSy_replace_with_your_google_cloud_api_key
