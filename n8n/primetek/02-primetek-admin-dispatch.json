{
  "name": "PRIMETEK - 02 Admin Panel Direct WhatsApp Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "primetek/v1/admin-message",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "primetek-admin-webhook",
      "name": "PRIMETEK Admin Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        340
      ],
      "webhookId": "primetek-v1-admin-message"
    },
    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\n\nconst clientKey = headers['x-primetek-key'] || headers['x-api-key'] || headers['authorization'];\nconst expectedKey = $env.PRIMETEK_GATEWAY_API_KEY || 'primetek_sec_change_in_env';\n\nif (!clientKey || clientKey !== expectedKey) {\n  return [{\n    json: {\n      authenticated: false,\n      error: 'Unauthorized: Invalid or missing x-primetek-key',\n      statusCode: 401\n    }\n  }];\n}\n\nconst phone = body.to || body.phone;\nconst text = body.message || body.text;\n\nif (!phone || !text) {\n  return [{\n    json: {\n      authenticated: false,\n      error: 'Bad Request: Both \"to\" and \"message\" fields are required',\n      statusCode: 400\n    }\n  }];\n}\n\nconst cleanPhone = String(phone).replace(/[^0-9]/g, '');\n\nreturn [{\n  json: {\n    authenticated: true,\n    cleanPhone: cleanPhone,\n    message: String(text).trim(),\n    instance: $env.WA_INSTANCE_PRIMETEK || 'primetek_store',\n    statusCode: 200\n  }\n}];"
      },
      "id": "code-admin-validate",
      "name": "Validate Admin Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "admin-auth-check",
              "leftValue": "={{ $json.authenticated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-admin-auth",
      "name": "Is Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        340
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"{{ $json.error }}\"\n}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "respond-admin-error",
      "name": "Return Auth Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.EVOLUTION_INTERNAL_URL || 'http://evolution_api:8080') + '/message/sendText/' + ($env.WA_INSTANCE_PRIMETEK || 'primetek_store') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.cleanPhone }}\",\n  \"text\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "id": "http-admin-send-wa",
      "name": "Send WhatsApp to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "evolution-header-auth",
          "name": "Evolution API Key Header"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"sent\",\n  \"service\": \"PRIMETEK Admin\",\n  \"recipient\": \"{{ $('Validate Admin Message').item.json.cleanPhone }}\",\n  \"instance\": \"{{ $env.WA_INSTANCE_PRIMETEK || 'primetek_store' }}\",\n  \"timestamp\": {{ Math.floor(Date.now() / 1000) }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-admin-success",
      "name": "Return Success to Admin Panel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1220,
        240
      ]
    }
  ],
  "connections": {
    "PRIMETEK Admin Webhook": {
      "main": [
        [
          {
            "node": "Validate Admin Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Admin Message": {
      "main": [
        [
          {
            "node": "Is Authorized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Authorized?": {
      "main": [
        [
          {
            "node": "Send WhatsApp to Customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Auth Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp to Customer": {
      "main": [
        [
          {
            "node": "Return Success to Admin Panel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
